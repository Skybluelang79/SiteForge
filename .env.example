# ---------------------------------------------------------------------------
# SiteForge environment template
# Local backend: copy this file to backend/.env and adjust as needed.
# Docker Compose: copy this file to .env if you want to override compose defaults.
# Never commit a real .env file.
# ---------------------------------------------------------------------------

DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_TRUST_PROXY_HEADERS=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Cloudflare Turnstile and Cloudflare Access are disabled unless enabled and configured.
TURNSTILE_ENABLED=False
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=
CLOUDFLARE_ACCESS_ENABLED=False
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
CLOUDFLARE_ACCESS_AUD=

# Leave DATABASE_URL unset to use SQLite at backend/db.sqlite3.
# DATABASE_URL=postgresql://siteforge:siteforge@localhost:5432/siteforge

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=False

# Use the in-memory channel layer when running without Redis locally.
# USE_IN_MEMORY_CHANNEL_LAYER=True

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@siteforge.local

# AI assistant. Without AI_API_KEY the assistant answers from live database
# analysis. Point AI_BASE_URL at any OpenAI-compatible endpoint.
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=25

# Local file storage by default. Set STORAGE_BACKEND=s3 for object storage.
STORAGE_BACKEND=local
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=

# AI copilot (OpenAI-compatible /chat/completions provider).
# Leave AI_API_KEY empty to use the deterministic, data-grounded fallback.
# Works with OpenAI, OpenRouter, Groq and similar compatible gateways.
AI_ENABLED=True
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
AI_TIMEOUT_SECONDS=30
AI_MAX_TOKENS=900
AI_TEMPERATURE=0.2
THROTTLE_ASSISTANT=30

# Docker Compose overrides
POSTGRES_DB=siteforge
POSTGRES_USER=siteforge
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=8080
MAILPIT_PORT=8025
SEED_DEMO_DATA=0
