# ---------------------------------------------------------------------------
# SiteForge environment template
# Local backend: copy this file to backend/.env and adjust as needed.
# Docker Compose: copy this file to .env if you want to override compose defaults.
# Never commit a real .env file.
# ---------------------------------------------------------------------------

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Leave DATABASE_URL unset to use SQLite at backend/db.sqlite3.
# DATABASE_URL=postgresql://siteforge:siteforge@localhost:5432/siteforge

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=False

# Use the in-memory channel layer when running without Redis locally.
# USE_IN_MEMORY_CHANNEL_LAYER=True

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@siteforge.local

# Local file storage by default. Set STORAGE_BACKEND=s3 for object storage.
STORAGE_BACKEND=local
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=

# Docker Compose overrides
POSTGRES_DB=siteforge
POSTGRES_USER=siteforge
POSTGRES_PASSWORD=siteforge
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=8080
MAILPIT_PORT=8025
SEED_DEMO_DATA=0
