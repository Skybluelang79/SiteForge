# Backend (Django) environment - copy to backend/.env for local dev or set as Fly secrets/env

DJANGO_SECRET_KEY=change-me-to-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.fly.dev

# Database (Fly Postgres sets DATABASE_URL automatically when attached)
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Redis / Channels / Celery (use Upstash Redis or Fly Redis URL)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=False

# Frontend origins (set to your Vercel URL, include previews if needed)
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app
FRONTEND_URL=https://your-app.vercel.app
SITE_URL=https://your-backend.fly.dev

# Optional
USE_IN_MEMORY_CHANNEL_LAYER=False
SEED_DEMO_DATA=0
DJANGO_SECURE_SSL_REDIRECT=False
